{
  "file_format": "{0:yyyyMM}-tax-al.xml",
  "sql": { "InputFile": "get-data.sql", "QueryTimeout": 1800 },
  "mail": {
    "from": "sender@example.invalid",
    "to": ["filer@example.invalid"],
    "subject": "AL Taxes"
  },
  "msgraph": {
    "tenant_id": "TENANT_GUID",
    "client_id": "APP_CLIENT_GUID",
    "client_secret": ""
  },
  "mctf": {
    "state": "AL",
    "filer_id": "012345678",
    "state_options": { "Etin": "12345", "AgentIdentifier": "XMLTRN" },
    "submit": { "window": [14, 20] }
  },
  "companytypes": [
    { "t": "Supplier",  "k": "supplier.cmp_id",  "f": ["supplier.cmp_id", "supplier.name", "supplier.tax_id"] },
    { "t": "Consignee", "k": "consignee.cmp_id", "f": ["consignee.cmp_id", "consignee.name", "consignee.tax_id"] }
  ],
  "tests": [
    { "type": "Freight",   "name": "BOL is not a 3 to 12 digit number", "field": "bol",             "test": "^[0-9]{3,12}$" },
    { "type": "Supplier",  "name": "Supplier tax id is not 9 digits",   "field": "supplier.tax_id", "test": "^[0-9]{9}$" },
    { "type": "Consignee", "name": "Consignee tax id is not 9 digits",  "field": "consignee.tax_id","test": "^[0-9]{9}$" }
  ]
}
