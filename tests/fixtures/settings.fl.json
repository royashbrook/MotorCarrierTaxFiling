{
  "file_format": "{0:yyyyMM}.csv",
  "sql": "get-data.sql",
  "mail": {
    "from": "sender@example.invalid",
    "to": ["filer@example.invalid"],
    "subject": "FL Taxes"
  },
  "msgraph": {
    "tenant_id": "TENANT_GUID",
    "client_id": "APP_CLIENT_GUID",
    "client_secret": ""
  },
  "mctf": {
    "state": "FL",
    "filer_id": "012345678"
  },
  "companytypes": [
    { "t": "Shipper",   "k": "shipper.cmp_id",   "f": ["shipper.cmp_id", "shipper.name", "shipper.state", "shipper.tcn"] },
    { "t": "Supplier",  "k": "supplier.cmp_id",  "f": ["supplier.cmp_id", "supplier.name", "supplier.tax_id"] },
    { "t": "Consignor", "k": "consignor.cmp_id", "f": ["consignor.cmp_id", "consignor.name", "consignor.tax_id"] },
    { "t": "Consignee", "k": "consignee.cmp_id", "f": ["consignee.cmp_id", "consignee.name", "consignee.address", "consignee.city", "consignee.state", "consignee.zip", "consignee.tax_id", "consignee.dep"] }
  ],
  "tests": [
    { "type": "Freight",   "name": "BOL is not a 3 to 12 digit number",       "field": "bol",              "test": "^[0-9]{3,12}$" },
    { "type": "Freight",   "name": "Net is not a 3 to 6 digit number",        "field": "net",              "test": "^[0-9]{3,6}$" },
    { "type": "Freight",   "name": "Gross is not a 3 to 6 digit number",      "field": "gross",            "test": "^[0-9]{3,6}$" },
    { "type": "Shipper",   "name": "Shipper TCN is not a valid terminal code", "field": "shipper.tcn",      "test": "^T[0-9]{2}[A-Z]{2}[0-9]{4}$" },
    { "type": "Supplier",  "name": "Supplier tax id is not 9 digits",         "field": "supplier.tax_id",  "test": "^[0-9]{9}$" },
    { "type": "Consignor", "name": "Consignor tax id is not 9 digits",        "field": "consignor.tax_id", "test": "^[0-9]{9}$" },
    { "type": "Consignee", "name": "Consignee tax id is not 9 digits",        "field": "consignee.tax_id", "test": "^[0-9]{9}$" },
    { "type": "Consignee", "name": "Consignee DEP is not 9 digits",           "field": "consignee.dep",    "test": "^[0-9]{9}$" }
  ]
}
